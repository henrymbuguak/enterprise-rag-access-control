# Profiles switch services on as you reach them:
#   Phase 6 (Linux only): ollama   Phase 8: api   Phase 9: airflow   Phase 10: events   Phase 14: monitoring
COMPOSE_PROFILES=

# Postgres: the admin role plays the identity provider and owns the audit log;
# app_user is the assistant's read-only role with row-level security enforced.
PG_ADMIN_DSN=postgresql://brimmora:brimmora@postgres:5432/brimmora
PG_APP_DSN=postgresql://app_user:app_user@postgres:5432/brimmora

# MinIO plays SharePoint: documents plus their ACL metadata
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=brimmora
MINIO_SECRET_KEY=brimmora-secret
BUCKET=corpus

OPENSEARCH_URL=http://opensearch:9200
INDEX_ALIAS=brimmora-chunks
KAFKA_BROKERS=redpanda:9092
EVENTS_TOPIC=minio-events

# macOS: run Ollama natively (it uses the GPU). Linux: set http://ollama:11434 and add ollama to COMPOSE_PROFILES.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.1:8b

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VERSION=v1
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_WORDS=180
CHUNK_OVERLAP=30
MIN_RELEVANCE=0.0

REGION=eu-west
TENANT_ID=manufacturing
# Production uses 600 (10 minutes). 60 keeps the ACL-drift test in Phase 16 short.
GROUP_CACHE_TTL_SECONDS=60
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
DEV_MODE=true
PROMPT_VERSION=answer-v1
API_URL=http://api:8000
